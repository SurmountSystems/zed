#!/usr/bin/env bash
set -euo pipefail

UPSTREAM_REF="${1:-origin/main}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo '{"error":"not a git repository"}' >&2
  exit 1
fi

if [[ ! -f SURMOUNT.md ]]; then
  echo '{"error":"SURMOUNT.md not found; not a Surmount workspace"}' >&2
  exit 1
fi

MERGE_BASE="$(git merge-base HEAD "$UPSTREAM_REF")"
NAME_STATUS="$(git diff --name-status -z "$MERGE_BASE"..HEAD)"
CONFLICTS="$(git diff --name-only --diff-filter=U -z || true)"

python3 - <<'PY' "$MERGE_BASE" "$UPSTREAM_REF" "$NAME_STATUS" "$CONFLICTS"
import json, sys

merge_base, upstream_ref, name_status, conflicts_raw = sys.argv[1:5]
conflicts = {p for p in conflicts_raw.split("\0") if p}

entries = []
chunk = name_status.split("\0")
i = 0
while i < len(chunk):
    part = chunk[i]
    if not part:
        i += 1
        continue
    if "\t" in part:
        status, path = part.split("\t", 1)
    else:
        status = part
        path = chunk[i + 1] if i + 1 < len(chunk) else ""
        i += 1
    if path:
        entries.append({
            "path": path.replace("\\", "/"),
            "status": status,
            "is_conflict": path in conflicts,
        })
    i += 1

print(json.dumps({
    "merge_base": merge_base,
    "upstream_ref": upstream_ref,
    "changed_files": entries,
    "manifest": "surmount-merge-categories.toml",
    "skill": ".agents/skills/surmount-merge-review/SKILL.md",
}, indent=2))
PY