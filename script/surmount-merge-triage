#!/usr/bin/env bash
set -euo pipefail

UPSTREAM_REF="${1:-origin/main}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo '{"error":"not a git repository"}' >&2
  exit 1
fi

if [[ ! -f SURMOUNT.md ]]; then
  echo '{"error":"SURMOUNT.md not found; not a Surmount workspace"}' >&2
  exit 1
fi

WORKTREE_ROOT="$(git rev-parse --show-toplevel)"
export WORKTREE_ROOT UPSTREAM_REF

MERGE_BASE="$(git merge-base HEAD "$UPSTREAM_REF")"
export MERGE_BASE

python3 <<'PY'
import json
import os
import subprocess

worktree_root = os.environ["WORKTREE_ROOT"]
upstream_ref = os.environ["UPSTREAM_REF"]
merge_base = os.environ["MERGE_BASE"]

name_status = subprocess.run(
    ["git", "diff", "--merge-base", upstream_ref, "--name-status", "-z"],
    check=True,
    capture_output=True,
).stdout.decode("utf-8", errors="surrogateescape")

conflicts_raw = subprocess.run(
    ["git", "diff", "--name-only", "--diff-filter=U", "-z"],
    capture_output=True,
).stdout.decode("utf-8", errors="surrogateescape")

conflicts = {p for p in conflicts_raw.split("\0") if p}

entries = []
parts = [p for p in name_status.split("\0") if p]
i = 0
while i < len(parts):
    status = parts[i]
    if status in {"M", "A", "D"}:
        i += 1
        path = parts[i] if i < len(parts) else ""
        i += 1
    else:
        i += 1
        continue
    if not path:
        continue
    normalized = path.replace("\\", "/")
    full_path = os.path.join(worktree_root, normalized)
    if os.path.isdir(full_path):
        continue
    entries.append({
        "path": normalized,
        "status": status,
        "is_conflict": normalized in conflicts,
    })

print(json.dumps({
    "merge_base": merge_base,
    "upstream_ref": upstream_ref,
    "changed_files": entries,
    "changed_file_count": len(entries),
    "manifest": "surmount-merge-categories.toml",
    "skill": ".agents/skills/surmount-merge-review/SKILL.md",
}, indent=2))
PY